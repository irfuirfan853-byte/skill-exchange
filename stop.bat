@echo off\r\ntitle Skill Exchange - Stop Server\r\ncd /d "%~dp0"\r\n\r\nif not exist ".freebuff\\app.pid" (\r\n    echo No running server found (or it was already stopped).\r\n    pause\r\n    exit /b 0\r\n)\r\n\r\nset /p PID=<.freebuff\\app.pid\r\ndel .freebuff\\app.pid >nul 2>&1\r\ntaskkill /PID %PID% /F >nul 2>&1\r\nif errorlevel 1 (\r\n    echo The server was not running.\r\n) else (\r\n    echo Server stopped.\r\n)\r\npause\r\n